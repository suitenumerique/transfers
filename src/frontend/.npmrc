# Isolated layout: each package version is stored once under
# node_modules/.store and linked where it is needed. Fewer files to write than
# the hoisted layout, and code cannot import a package it does not declare.
install-strategy=linked

# Resolve only versions published at least a day ago (npm >= 11.16), so a
# hijacked release is usually pulled before `npm install` can pick it up.
# `npm ci` installs the lockfile as is.
min-release-age=1

# An older npm silently ignores min-release-age: refuse to run when the npm or
# Node version does not match engines in package.json.
engine-strict=true
