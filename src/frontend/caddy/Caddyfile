{
	auto_https off
	admin off
	servers {
		# {client_ip} is the TCP peer, unless the peer is one of these
		# proxies: then it comes from X-Forwarded-For, walked right to
		# left to the first address that is not a trusted proxy
		# (trusted_proxies_strict). A client-appended prefix never wins.
		trusted_proxies static {$TRANSFERTS_FRONTEND_TRUSTED_PROXIES}
		trusted_proxies_strict
	}
}

:{$PORT} {
	root * {$TRANSFERTS_FRONTEND_ROOT:/app}

	# Security headers on every response Caddy emits (HTML + assets). The
	# Django backend sets its own on /api/* responses; these cover the
	# statically-exported frontend, including the /t/<token> download page.
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		# The download page carries the secret token in its URL path. With
		# same-origin we never send a Referer cross-origin, so the token can't
		# leak to the LaGaufre origins via the Referer header.
		Referrer-Policy "same-origin"
		# same-origin-allow-popups, not same-origin: we keep window.opener
		# alive for popups we open (Drive picker OAuth). Tabs opened by a
		# cross-origin page still see opener=null when they navigate here,
		# isolating our browsing context group from any malicious opener.
		Cross-Origin-Opener-Policy "same-origin-allow-popups"
		# Lock down browser APIs we never use, so an XSS can't escalate into
		# the recipient's microphone, camera, geolocation, payment dialog,
		# USB/serial/MIDI devices, or screen capture.
		Permissions-Policy "accelerometer=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), serial=(), usb=()"
		# Strict CSP: a compromised LaGaufre script update must not be able to
		# exfiltrate a recipient's download token. Only self + whatever the
		# deployment opts into is allowed. The two GAUFRE origins default to
		# empty (widget off); set them to the script host and the services API
		# host of your Suite operator, matching the backend's
		# LAGAUFRE_WIDGET_URL / LAGAUFRE_API_URL. For La Suite territoriale:
		#   TRANSFERTS_FRONTEND_GAUFRE_SCRIPT_ORIGIN=https://static.suite.anct.gouv.fr
		#   TRANSFERTS_FRONTEND_GAUFRE_API_ORIGIN=https://operateurs.suite.anct.gouv.fr
		Content-Security-Policy "default-src 'self'; script-src 'self' {$TRANSFERTS_FRONTEND_GAUFRE_SCRIPT_ORIGIN}; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: {$TRANSFERTS_FRONTEND_GAUFRE_SCRIPT_ORIGIN} {$TRANSFERTS_FRONTEND_GAUFRE_API_ORIGIN}; font-src 'self' data:; connect-src 'self' {$TRANSFERTS_FRONTEND_GAUFRE_SCRIPT_ORIGIN} {$TRANSFERTS_FRONTEND_GAUFRE_API_ORIGIN} {$TRANSFERTS_FRONTEND_S3_ORIGIN:https://s3.fr-par.scw.cloud}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
	}

	route {
		# Health checks
		respond /__lbheartbeat__ 200
		respond /__lbheartbeat__/ 200

		# The backend gets the client IP Caddy established (see the global
		# trusted_proxies block): one address, never a client-written chain,
		# and the audit log keeps the user's IP as long as the edge router
		# is a trusted proxy.
		reverse_proxy /__heartbeat__/* {$TRANSFERTS_FRONTEND_BACKEND_SERVER:localhost:8000} {
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-For {client_ip}
		}

		# Django backend proxy
		reverse_proxy /api/* {$TRANSFERTS_FRONTEND_BACKEND_SERVER:localhost:8000} {
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-For {client_ip}
		}

		# Django admin IP allowlist. The default admits every client (no
		# filtering); a CIDR list restricts the admin URL to those clients,
		# as established above — a spoofed X-Forwarded-For does not pass.
		@admin_denied {
			path /{$DJANGO_ADMIN_URL:admin} /{$DJANGO_ADMIN_URL:admin}/*
			not client_ip {$DJANGO_ADMIN_IP_ALLOWLIST:0.0.0.0/0 ::/0}
		}
		respond @admin_denied 403

		redir /{$DJANGO_ADMIN_URL:admin} /{$DJANGO_ADMIN_URL:admin}/ 301

		reverse_proxy /{$DJANGO_ADMIN_URL:admin}/* {$TRANSFERTS_FRONTEND_BACKEND_SERVER:localhost:8000} {
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-For {client_ip}
		}

		reverse_proxy /static/* {$TRANSFERTS_FRONTEND_BACKEND_SERVER:localhost:8000} {
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-For {client_ip}
		}

		# The E2E decryption Service Worker. Lives at the root so its default
		# scope covers /_dl/<token>/<file_id>/... — no Service-Worker-Allowed
		# header needed. Disable caching so a new deploy's SW takes over at
		# the next page load instead of riding the browser's default 24h
		# max-age.
		@sw path /sw.js
		handle @sw {
			header Cache-Control "no-cache"
			file_server
		}

		# Serve static assets. Missing files fall through to handle_errors
		# below, which applies the SPA fallback for document navigations only.
		file_server
	}

	handle_errors {
		# SPA fallback: serve index.html for missing document navigations so the
		# client-side router (TanStack Router) can resolve the path. Scoped to
		# requests that accept HTML, so missing static assets (JS/CSS chunks)
		# keep their 404 instead of getting a 200 index.html — chunk-load
		# failures and stale-cache issues stay visible. /_dl/* is excluded
		# too: those URLs only exist inside the decryption Service Worker, so
		# one reaching Caddy means the worker didn't intercept it, and a
		# plain 404 says so where a silent index.html in a hidden iframe
		# wouldn't.
		@spa_404 expression `{err.status_code} == 404 && !path('/_dl/*')`
		handle @spa_404 {
			@html header Accept *text/html*
			handle @html {
				rewrite * /index.html
				# 200, not the 404 we arrived with: this *is* the page for
				# that URL as far as the browser, caches and crawlers go.
				file_server {
					status 200
				}
			}
		}
	}
}
