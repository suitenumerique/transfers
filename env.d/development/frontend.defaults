# Empty: the dev server proxies the backend's prefixes, as Caddy does in
# production, so the API is same-origin and the frontend derives it from
# window.location. Set it to an absolute URL only to point the app at a
# backend somewhere else -- per-domain configuration and the session
# cookie both stop working across two origins.
NEXT_PUBLIC_API_ORIGIN=
NEXT_PUBLIC_FEEDBACK_WIDGET_API_URL=
NEXT_PUBLIC_FEEDBACK_WIDGET_PATH=
NEXT_PUBLIC_FEEDBACK_WIDGET_CHANNEL=
NEXT_PUBLIC_HELP_CENTER_URL=
NEXT_PUBLIC_LANGUAGES=[["en-US","English"],["fr-FR","Français"]]
NEXT_PUBLIC_DEFAULT_LANGUAGE=en-US
## Chunk size for multipart upload in MB
NEXT_PUBLIC_MULTIPART_UPLOAD_CHUNK_SIZE=100

## Sentry
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=

## Theme Customization
NEXT_PUBLIC_THEME_CONFIG='{
    "theme": "white-label"
}'

