# App database configuration
DB_HOST=postgresql
DB_NAME=transfers
DB_USER=user
DB_PASSWORD=pass
DB_PORT=5432

# Django
DJANGO_ALLOWED_HOSTS=*
DJANGO_SECRET_KEY=ThisIsAnExampleKeyForDevPurposeOnly
DJANGO_SETTINGS_MODULE=transfers.settings
DJANGO_SUPERUSER_PASSWORD=admin
DJANGO_DATA_DIR=/data

# Logging
LOGGING_LEVEL_HANDLERS_CONSOLE=INFO
LOGGING_LEVEL_LOGGERS_ROOT=INFO
LOGGING_LEVEL_LOGGERS_APP=INFO

# Python
PYTHONPATH=/app

# Mail
DJANGO_EMAIL_HOST="mailcatcher"
DJANGO_EMAIL_PORT=1025
# Branding is deployment-supplied (see settings.py, "Branding of the
# notification emails"). Left unset here so dev mails use the neutral
# defaults: shipped Transfers wordmark in the header, no footer logo.
# To preview an institutional footer locally, host the PNGs yourself and:
# DJANGO_EMAIL_FOOTER_LOGOS='[{"url":"http://localhost:8900/images/my-logo.png","alt":"My org","width":80,"height":44}]'
# DJANGO_EMAIL_LOGO_IMG="http://localhost:8900/images/my-wordmark.png"

# S3 Object Storage
AWS_S3_ENDPOINT_URL=http://objectstorage:9000
AWS_S3_ACCESS_KEY_ID=transfers
AWS_S3_SECRET_ACCESS_KEY=password
AWS_S3_SIGNATURE_VERSION=s3v4
AWS_S3_DOMAIN_REPLACE=http://localhost:8986

# Transfers storage bucket
AWS_STORAGE_BUCKET_NAME=transfers

# Transfer size caps (bytes)
TRANSFER_MAX_FILE_SIZE=21474836480
TRANSFER_MAX_TOTAL_SIZE=21474836480

OIDC_CREATE_USER=True

# OIDC endpoints — point at the LOCAL Keycloak (see the `keycloak` service in
# compose.yaml), so dev works without a real ProConnect instance. The flow is
# the genuine OIDC code flow, just against a self-hosted provider.
#
# Split hostnames on purpose:
#   - authorize/logout → localhost:8902  (the BROWSER is redirected here)
#   - token/userinfo/jwks → keycloak:8802 (the BACKEND calls these in-network;
#     localhost:8902 is unreachable from inside the backend container)
# Keycloak runs with --hostname=http://localhost:8902, so the issuer/URLs it
# stamps stay consistent regardless of which host answered the request.
OIDC_OP_AUTHORIZATION_ENDPOINT=http://localhost:8902/realms/transfers/protocol/openid-connect/auth
OIDC_OP_TOKEN_ENDPOINT=http://keycloak:8802/realms/transfers/protocol/openid-connect/token
OIDC_OP_USER_ENDPOINT=http://keycloak:8802/realms/transfers/protocol/openid-connect/userinfo
OIDC_OP_JWKS_ENDPOINT=http://keycloak:8802/realms/transfers/protocol/openid-connect/certs
OIDC_OP_LOGOUT_ENDPOINT=http://localhost:8902/realms/transfers/protocol/openid-connect/logout

# Dev client + secret are committed on purpose — they only match the local
# realm imported from src/keycloak/realm.json, never anything real.
OIDC_RP_CLIENT_ID=transfers
OIDC_RP_CLIENT_SECRET=transfers-dev-secret
OIDC_RP_SIGN_ALGO=RS256
OIDC_RP_SCOPES="openid email profile"
# Keycloak emits given_name/family_name (not first_name/last_name). NB:
# django-configurations ListValue splits on commas — these must be a bare
# comma-separated list, NOT JSON, or each entry gets mangled.
OIDC_USERINFO_FULLNAME_FIELDS=given_name,family_name

# Only behind a proxy that rewrites Host *and* sets X-Forwarded-Host.
# The configuration resolver reads the host, so getting this wrong
# serves the neutral theme to every domain without an error.
# USE_X_FORWARDED_HOST=False

LOGIN_REDIRECT_URL=http://localhost:8980
LOGIN_REDIRECT_URL_FAILURE=http://localhost:8980/errors
LOGOUT_REDIRECT_URL=http://localhost:8980

# Hosts, not origins: mozilla-django-oidc hands these to Django's
# url_has_allowed_host_and_scheme, which compares the candidate URL's
# netloc. An entry carrying a scheme can therefore never match, and a
# ?next= to that host is silently dropped back to LOGIN_REDIRECT_URL.
# opsn1.localhost is the alias of the multi-domain demo further down, so a
# login started there comes back there.
OIDC_REDIRECT_ALLOWED_HOSTS=localhost:8980,localhost:8981,opsn1.localhost:8980

# OIDC userinfo claim names persisted on ``User.claims`` (JSON). Use the same
# names as in ``ENTITLEMENTS_BACKEND_PARAMETERS`` → ``oidc_claims`` when using
# DeployCenter (e.g. ``siret``). Keycloak must expose those claims in userinfo.
# A bare comma-separated list, NOT JSON (ListValue, like
# OIDC_USERINFO_FULLNAME_FIELDS above): ``["siret"]`` would name a claim
# ``["siret"]``. Leave empty to store none.
# If DeployCenter still requires ``siret`` but OIDC does not send it, add
# ``"claim_defaults": {"siret": "..."}`` inside ENTITLEMENTS_BACKEND_PARAMETERS.
OIDC_STORE_CLAIMS=

# Drive integration — leave blank to hide the "Attach from Drive" button.
# Set to your Drive instance base URL (e.g. https://drive.example.gouv.fr)
# to enable it. The target Drive must allow our origin in BOTH
# `CORS_ALLOWED_ORIGINS` AND `SDK_CORS_ALLOWED_ORIGINS`, and keep
# `CORS_ALLOW_CREDENTIALS=True`.
DRIVE_BASE_URL=

# LaGaufre (La Suite app switcher) — leave blank to hide it. Both must be set
# for the widget to render; the frontend's Caddy CSP must allow the same two
# origins (TRANSFERS_FRONTEND_GAUFRE_SCRIPT_ORIGIN / _API_ORIGIN).
# The API answers with the service list and its order; a &siret=<siret> on it
# scopes that answer to one organization, whoever is looking.
LAGAUFRE_WIDGET_URL=
LAGAUFRE_API_URL=

# Frontend
# Compiled Cunningham palette, read at runtime by the root shell. Must be one
# of the generated themes (default, dark, dsfr-light, dsfr-dark, anct-light,
# anct-dark). Leave empty for the neutral theme. DEFAULT_CONFIG's
# theme_customization.colors overrides individual tokens on top of whichever
# one this picks,
# so an operator whose palette nobody compiled needs no rebuild — which is why
# dev runs on "default" rather than anct-light.
FRONTEND_THEME=default

# Deployment configuration, resolved per request. Two variables, each also
# readable from a file via a <NAME>_FILE_PATH sibling (the file is the base,
# the inline value merges over it).
#
#   DEFAULT_CONFIG    the base, sectioned: {"theme_customization": {...}}
#   CONFIG_OVERRIDES  what differs per domain:
#                     {"<domain>": {"theme_customization": {...}}}
#
# An override states only what changes, so adding a domain never means
# restating a whole theme. Objects merge key by key; lists replace wholesale,
# which is the only way an override can remove a link rather than add one.
#
# The colours below move one rung of the brand ramp, which is enough to see
# the mechanism work but not to rebrand the interface: Cunningham components
# reference rungs across the whole 050..950 ladder (a tertiary button's label
# is brand-550). A real operator theme carries the whole ramp -- see the
# README.
#
# Only the theme_customization section is served to the browser, under the key
# of the same name that docs and drive already use; its shape is a superset of
# theirs, so a theme file written for docs drops in unchanged via
# THEME_CUSTOMIZATION_FILE_PATH. A section this version doesn't know stays
# server-side.
#
# The domain is the hostname the *API* was reached on, which is the
# frontend's own hostname: Caddy serves the app and proxies /api on the same
# origin in production, and the dev server does the same. So exercising the
# per-domain path locally is just a matter of browsing an alias --
# http://opsn1.localhost:8980 instead of http://localhost:8980. Same image,
# another brand. Most browsers resolve *.localhost to loopback on their own;
# add "127.0.0.1 opsn1.localhost" to /etc/hosts if yours does not.
#
# Signing in on the alias works too: the Keycloak realm lists it among its
# redirect URIs, and OIDC_REDIRECT_ALLOWED_HOSTS above carries it, so the
# login comes back to the domain it started from rather than to
# LOGIN_REDIRECT_URL's single host.
#
# One thing dev does not reproduce: the theme carries URLs, and in production
# the browser only loads an image or a font the frontend's CSP allows -- its
# own origin, a data: URI, or the origin
# TRANSFERS_FRONTEND_THEME_ASSET_ORIGIN declares. The Vite dev server sends no
# CSP at all, so a logo on a third-party origin works here and is blocked
# there, with a console violation as the only trace. Test an off-origin asset
# against the real image (make test-front-distroless builds it), not dev.
DEFAULT_CONFIG={"theme_customization": {"help": {"documentation_url": "https://example.test/help"}}}
CONFIG_OVERRIDES={"opsn1.localhost": {"theme_customization": {"colors": {"--c--globals--colors--brand-500": "#C83F49"}, "fontFamily": "Georgia, serif"}}}
# THEME_CUSTOMIZATION_FILE_PATH=/path/to/a/docs-shaped/theme.json
